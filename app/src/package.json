{
  "name": "moekaden-room-js",
  "productName": "MoekadenRoomJS",
  "version": "1.4.1",
  "description": "This app is An ECHONET Lite Emulator.",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "win": "electron-forge start",
    "mac": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "postinstall": "npm audit fix"
  },
  "homepage": "./",
  "keywords": [],
  "author": {
    "name": "Hiroshi SUGIMURA (Kanagawa Institute of Technology, JAPAN)",
    "email": "hiroshi.sugimura@gmail.com"
  },
  "license": "MIT",
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "myapp",
            "icon": "./icons/icon256x256.ico",
            "overwrite": "true"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  },
  "dependencies": {
    "date-utils": "^1.2.21",
    "echonet-lite": "^2.18.1",
    "electron-compile": "^6.4.4",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "highlight.js": "^11.11.1",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "electron": "39.2.7"
  }
}